# Optional server-side AI workflow provider
RELAY_AI_API_URL=
RELAY_AI_API_KEY=
RELAY_AI_MODEL=relay-default
RELAY_SERVER_PORT=8787

# Optional URL used by the Next.js API documentation playground
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# MCP adapter configuration
RELAY_API_BASE_URL=http://localhost:8787
RELAY_API_TOKEN=
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
OAUTH_SIGNING_SECRET=replace-with-a-different-long-random-secret
MCP_ALLOWED_HOSTS=relay-crm-api.onrender.com,localhost,localhost:*,127.0.0.1,127.0.0.1:*

# Optional server-side Next.js sequence generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional Gemini runtime; server only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Supabase Auth, Postgres, and Realtime
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# LinkedIn Community Management API (server-only)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8787/api/integrations/linkedin/callback
LINKEDIN_SCOPES=openid profile email rw_organization_admin
LINKEDIN_API_VERSION=202610
LINKEDIN_OAUTH_STATE_SECRET=
LINKEDIN_TOKEN_ENCRYPTION_KEY=
RELAY_APP_URL=http://localhost:5173
