# Relay CRM Backend Environment Configuration

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=*

# Database (defaults to local SQLite if empty)
# Render or Supabase: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./relay_crm.db

# AI Providers (Optional - deterministic high-quality fixtures are used if keys are omitted)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_MODEL=claude-3-5-sonnet-20241022
