{
  "name": "relay-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:api": "python -m uvicorn app.main:app --reload --port 8000 --app-dir backend",
    "dev:full": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:next\"",
    "dev:next": "next dev next-ui",
    "build:next": "next build next-ui",
    "export:next": "next build next-ui",
    "start:next": "next start next-ui"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
